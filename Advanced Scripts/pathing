pattern: pathTo
args[1]: end town in direction of travel
args[2]: optional stopping town along the road
Execute the following javascript:
----------------------------------------------------------------------------------------------------

var dir, road, stop, r = gwc.userdata.paths;

//specify road and direction of travel
switch(args[1]) {
    //sparkle
    case "faerie": dir = 0; road = r.sparkleFaerie; break;
    case "sparkle": dir = 1; road = r.sparkleFaerie; break;
    //shire
    case "bree": dir = 0; road = r.shire; break;
    case "gh": dir = 1; road = r.shire; break;
    case "waymeet": dir = 0; road = r.nsRoad; break;
    case "sarnFord": dir = 1; road = r.nsRoad; break;
    //gont
    case "tenAlders": dir = 0; road = r.gont; break;
    case "gont": dir = 1; road = r.gont; break;
    //krynn
    case "solace": dir = 1; road = r.krynn; break;
    case "tantallon": dir = 0; road = r.krynn; break;
    default: 
        gwc.output.append("unknown road: " + args[1]); break;
}

//optionally stop somewhere along the road
//if omitted you'll travel to the end of the road 
if(args[2]) {
    switch(args[2]) {
        //sparkle
        case "orcFortress": stop = "zJmIW/"; break;
        case "orcCampN": stop = "YzHdl."; break;
        case "orcCampS": stop = "iESC40"; break;
        //shire
        case "michDel": stop = "de6Lf/"; break;
        case "waymeet": stop = "FB.r4/"; break; 
        case "hobbiton": stop = "Wnvdx1"; break;
        case "longbottom": stop = "i6lc.."; break;
        case "frogmorton": stop = "LL9Jr0"; break;
        case "farm": stop = "ca6I2."; break;
        case "barrowDowns": stop = "Z8x031"; break;
        case "crossroads": stop = "WZJQJ0"; break;
        default: 
        gwc.output.append("unknown stop: " + args[2]); break;
    }
}

gwc.trigger.enable("fast travel");

//called from "fast travel" trigger when entering a new room
gwc.userdata.paths.move = function(roomId) {  
    if(road && road[roomId]) {
        if(stop && (stop === roomId)) {
            arrive();
        } else {
            //move to next room
            gwc.connection.send(road[roomId][dir]);
        }
    } else { //you're not on the road anymore
        arrive();
    }
};

function arrive() {
    gwc.output.append("End of the road.");
    gwc.trigger.disable("fast travel");
}

//start moving
gwc.userdata.paths.move(gwc.gmcp.data.room.id);

