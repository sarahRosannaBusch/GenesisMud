var keepContainer = "jar";
var sellContainer = "leather pouch"; 

var cures = gwc.userdata.herbs.cures;
var buffs = gwc.userdata.herbs.buffs;
var heals = gwc.userdata.herbs.heals;
var stims = gwc.userdata.herbs.stims;
var mana = gwc.userdata.herbs.mana;
var foods = gwc.userdata.herbs.foods;
var cooks = gwc.userdata.herbs.cooks;
var poison = gwc.userdata.herbs.poison;
var trash = gwc.userdata.herbs.trash;

var keep = cures.concat(buffs, heals, stims, mana);
var sell = trash.concat(cooks, poison, foods);

//fill keep bag
gwc.connection.send("open " + keepContainer);
var len = keep.length;
for(var i = 0; i < len; i++) {
  gwc.connection.send("put " + keep[i] + " in " + keepContainer);
}

//fill sell bag
