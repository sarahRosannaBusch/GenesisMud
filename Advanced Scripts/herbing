Pattern: auto_herb
args[1]: name of road (sparkle, gont, shire, krynn) | off
Execute the following javascript:
----------------------------------------------------------------------------------------------------

gwc.userdata.herbing = true;
var road, dir = 0;
switch(args[1]) {
    case "sparkle": road = gwc.userdata.paths.sparkleFaerie; break;
    case "gont": road = gwc.userdata.paths.gont; break;
    case "shire": road = gwc.userdata.paths.nsRoad; break;
    case "krynn": road = gwc.userdata.paths.krynn; break;
    case "off": gwc.userdata.herbing = false; break;
    default: gwc.output.append("unknown road: " + args[1]); break;
}
gwc.output.append("herbing in " + args[1]);

gwc.userdata.autoHerb = function() {  
    var roomId = gwc.gmcp.data.room.id;
    if(road[roomId]) {
        gwc.connection.send(road[roomId][dir]);
        gwc.connection.send("shh");
    } else {
        gwc.userdata.herbing = false;
        gwc.output.append("End of the road");
    }
}


